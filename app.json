{
  "expo": {
    "name": "Wake Word",
    "slug": "wake-word",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.wakeword.alarm",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Wake Word listens when you say a word out loud."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E2561F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.wakeword.alarm"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Wake Word uses the camera for photo hunts: find the object and take its picture.",
          "microphonePermission": "Wake Word listens when you say a word out loud.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Wake Word listens when you say a word out loud."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Wake Word listens when you say a word out loud.",
          "speechRecognitionPermission": "Wake Word checks that you said the word right."
        }
      ],
      "./plugins/withWakeAlarm.js"
    ],
    "scheme": "wakeword",
    "extra": {
      "photoCheckUrl": "",
      "photoCheckToken": ""
    }
  }
}
